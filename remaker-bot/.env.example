# ReMaker AI — Variabili d'ambiente
# Copia questo file in .env e compila i valori

# Chiave API OpenAI — ottienila su https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Token del bot Telegram — ottienilo da @BotFather su Telegram
TELEGRAM_BOT_TOKEN=123456789:ABC-...

# URL pubblico del servizio su Render (solo per deploy cloud)
# Lascia vuoto per usare il bot in locale con polling
# Esempio: https://remaker-bot.onrender.com
WEBHOOK_URL=
